<?php
    if (!isset($latlng)) {
        return;
    }
    if (!$latlng) {
        $latlng = '42.13627,24.76276';
    }
    $latLngArr = explode(',', $latlng);
    if (count($latLngArr) !== 2) return;
    $lat = $latLngArr[0];
    $lng = $latLngArr[1];
    
    $markerLat = false;
    $markerLng = false;
    if (isset($markerlatlng) && $markerlatlng) {
        $markerLatLngArr = explode(',', $markerlatlng);
        if (count($markerLatLngArr) === 2){
            $markerLat = $markerLatLngArr[0];
            $markerLng = $markerLatLngArr[1];
        }
    }
    
    $height = (isset($height) && $height) ? $height : 300;
    
    $scrollwheel = isset($enablescrollwheel) && $enablescrollwheel == 'true'; 
    $id = uniqid();
?>

<div id="google-map-<?php echo $id; ?>" class="gmap-container" style="height: <?php echo $height; ?>px;"></div>

<?php $this->scriptBlockStart(); ?>

$('#google-map-<?php echo $id; ?>').gummGoogleMap({
    center: {
        lat: <?php echo $lat; ?>,
        lng: <?php echo $lng; ?>
    },
    <?php if (isset($zoom) && $zoom): ?>
    zoom: <?php echo (int) $zoom; ?>,
    <?php endif; ?>
    <?php if ($markerLat && $markerLng): ?>
    marker: {
        lat: <?php echo $markerLat; ?>,
        lng: <?php echo $markerLng; ?>
    },
    <?php endif; ?>
    scrollwheel: <?php echo ($scrollwheel) ? 'true' : 'false'; ?>,
    controls: {
        pan: false,
        scale: false,
        streetView: true,
        overviewMap: false,
        zoom: true
    },
    controlOptions: {
        zoomControlOptions: {
            style: 'SMALL'
        },
        streetViewControlOptions: {
            position: 'TOP_LEFT'
        }
    }
});

<?php $this->scriptBlockEnd(); ?>