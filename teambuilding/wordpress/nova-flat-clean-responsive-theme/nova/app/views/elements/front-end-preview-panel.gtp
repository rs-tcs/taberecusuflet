                    <div class="gumm-slider-label"><span><?php echo $LayoutHelper->getContentWidth(); ?></span></div>
                    <div id="layout-content-width-slider" 
                        data-gumm-slider-value="<?php echo $contentWidth; ?>" 
                        data-gumm-resize-target=".bluebox-container"
                    ></div>
                </div>
            </div>
        </div>
        
        <strong class="demo-accordion-header background" data-tab-handle-for="background">
            <a href="#" class="demo-accordion-header-link">Background</a><span></span>
        </strong>
        <div class="front-end-demo-panel-content" style="display:none;" data-tab-content="background">
            <div class="front-end-demo-panel-inner-content">
                <select id="layout-background-chooser">
                    <option value="0">no image</option>
                <?php
                foreach ($backgroundImages as $url => $name) {
                    echo '<option value="' . $url . '">' . $name . '</option>';
                }
                ?>
                </select>
            </div>
