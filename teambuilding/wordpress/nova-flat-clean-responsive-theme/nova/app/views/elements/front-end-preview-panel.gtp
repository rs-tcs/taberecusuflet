        <strong class="demo-accordion-header font" data-tab-handle-for="font">
        	<a href="#" class="demo-accordion-header-link">Font</a><span></span>
        </strong>
        <div class="front-end-demo-panel-content" style="display:none;" data-tab-content="font">
            <div class="front-end-demo-panel-inner-content">
                <?php
                echo $this->Form->input('', array(
                    'id' => 'preview-google-fonts',
                    'type' => 'select',
                    'inputOptions' => $googleFontsList,
                    'name' => 'Google Web Fonts'
                ));
                ?>
            </div>
        </div>
        
    </div>
    <div id="front-end-demo-panel-colors-container" class="inner-panel-container bottom">
    	<?php foreach ($skinsData[$activeSkin] as $styleName => $styleVal): ?>
            <div class="preview-panel-color-detail" style="background-color: rgb(<?php echo $styleVal; ?>)" data-style-name="<?php echo $styleName; ?>"></div>
    	<?php endforeach; ?>
    </div>
</div>
    
<script type="text/javascript">
(function ($) {
$(window).load(function(){
    $('#front-end-preview-sidebars-container').css({display: 'none'});
});
$(document).ready(function(){
    $('#front-end-demo-panel').gummFrontEndDemoPanel({
        startPanelState: '<?php echo $panelState; ?>'
    });
});
$.gummFrontEndDemoPanel = function(options, callback, element) {
    this.element = $(element);
    this.__construct(options, callback);
}
$.gummFrontEndDemoPanel.settings = {
    start: 0,
    navItems: '.demo-accordion-header',
    contentItems: '.front-end-demo-panel-content',
    innerContent: '.front-end-demo-panel-inner-content',
    activeNavClass: 'current',
    skinsContainer: '#front-end-demo-panel-skins-container',
    skinSelectors: '.skin-selector',
    activeSkinSelectorClass: 'current',
    colorsContainer: '#front-end-demo-panel-colors-container',
    colorSelectors: '.preview-panel-color-detail',
    customUserSkinId: '<?php echo $customUserSkinId; ?>',
    layoutSelectors: '.layout-preview-option',
    layoutSidebarContainer: '#front-end-preview-sidebars-container',
    triggererButton: '#front-end-preview-panel-triggerer',
    closePanelButton: '#front-end-preview-panel-closer',
    layoutWidthSettings: '#front-end-demo-panel-layout-width-setttings',
    layoutWidthSlider: '#layout-width-slider',
    contentWidthSlider: '#layout-content-width-slider',
    layoutStyleSelect: '#front-end-layout-style-chooser',
    layoutWidthBreakPoints: {"min":["1600","1200","1100","979","768","480"],"max":["1600","1400","1300","1199","1099","1000","979","970","767","600","550","500","450","400","350"]},
    layoutWidthBootStrapBreakPoints: {"min":["1200", "768",],"max":["979","767","480"]},
    fontSelectBrowser: '#Preview-browser-fonts',
    fontSelectGoogle: '#Preview-google-fonts',
    backgroundChooser: '#layout-background-chooser',
    navMainChooser: '#Front-end-demo-panel-main-nav-chooser',
    navDropChooser: '#Front-end-demo-panel-drop-nav-chooser',
    startPanelState: 'opened'
}
$.gummFrontEndDemoPanel.prototype = {
    contentItems: [],
    current: 0,
    animating: false,
    styleStruct: <?php echo json_encode($stylesStructure); ?>,
    skinsData: <?Php echo json_encode($skinsData); ?>,
    activeSkin: '<?php echo $activeSkin; ?>',
    skinSelectors: {},
    activeColors: {},
    colorSelectors: {},
    styleSheetElements: {},
    styleSheetElementsTimeOuts: {},
    styleSheetElementTitle: 'gumm-preview-stylesheet-helper',
    styleSheetElement: null,
    layoutSchema: '<?php echo $layoutSchema; ?>',
    panelState: 'closed',
    position: {left: 0, top: 0},
    primeNavElement: $('.prime-nav'),
    navMainClassesAvailable: [],
    navDropClassesAvailable: [],
    gaugeCharts: [],
    __construct: function(options, callback) {
        var _self = this;
        this.options = $.extend(true, {}, $.gummFrontEndDemoPanel.settings, options);
        this.current = this.options.start;
        
        this.triggererButton = $(this.options.triggererButton);
        this.closerButton = $(this.options.closePanelButton);
        
        this.position.top = parseInt($('#wpadminbar').height()) + 20;
        this.position.left = -(this.element.width() + 40);
        this.element.css({
            top: this.position.top
        });
        this.panelState = this.options.startPanelState;
        
        this.pageContent = $('body > .container-fluid');
        this.pageContent.css({
            margin: '0 auto'
        });
        
        this.navItems = this.element.find(this.options.navItems);
        this.contentItems = this.element.find(this.options.contentItems);
        this.skinsContainer = this.element.find(this.options.skinsContainer);
        var _skinSelectors = this.skinsContainer.find(this.options.skinSelectors);
        _skinSelectors.each(function(i, ele){
            _self.skinSelectors[$(ele).data('skin-id')] = $(ele);
        });
        this.activeColors = this.skinsData[this.activeSkin];
        
        this.colorsContainer = this.element.find(this.options.colorsContainer);
        var _colorSelectors = this.colorsContainer.find(this.options.colorSelectors);
        _colorSelectors.each(function(i, ele){
            _self.colorSelectors[$(ele).data('style-name')] = $(ele);
        });
        
        $('body').append('<style title="' + this.styleSheetElementTitle + '"></style>');
        for (var i=document.styleSheets.length-1; i>=0; i--) {
            if (document.styleSheets[i].title == this.styleSheetElementTitle) {
                this.styleSheetElement = document.styleSheets[i];
                break;
            }
        }
        
        $.each(this.skinsData[this.activeSkin], function(styleName, styleVal) {
            $('body').append('<style id="' + styleName + '-preview-styles"></style>');
            _self.styleSheetElements[styleName] = document.styleSheets[document.styleSheets.length-1];
        });
        
        this.layoutSelectors = this.element.find(this.options.layoutSelectors);
        this.layoutSidebarsContainer = $(this.options.layoutSidebarContainer);
        
        this.contentItems.each(function(i, ele){
            if (i !== _self.current) {
                $(ele).css({
                    display: 'block',
                    height: 0
                });
            }
        });
        
        this.layoutWidthSlider = this.element.find(this.options.layoutWidthSlider);
        this.contentWidthSlider = this.element.find(this.options.contentWidthSlider);
        this.layoutStyleSelect = this.element.find(this.options.layoutStyleSelect);
        
        this.navMainChooser = this.element.find(this.options.navMainChooser);
        this.navDropChooser = this.element.find(this.options.navDropChooser);
        this.navMainChooser.find('option').each(function(i, ele){
            _self.navMainClassesAvailable.push($(ele).val());
        });
        this.navDropChooser.find('option').each(function(i, ele){
            _self.navDropClassesAvailable.push($(ele).val());
        });
        
        this.backgroundChooser = this.element.find(this.options.backgroundChooser);
        
        this.backgroundChooser.children('option').each(function(i, opt){
            if ($(opt).val() != '0') {
                $('<img src="' + $(opt).val() + '" />').load(function(){
                    
                });
            }
        });
        
        this.element.draggable({
            handle: '.panel-heading'
        });
        
        this.fontSelectBrowser = this.element.find(this.options.fontSelectBrowser);
        this.fontSelectGoogle = this.element.find(this.options.fontSelectGoogle);

        // this.options.layoutWidthBreakPoints.min = this.options.layoutWidthBreakPoints.min.sort();
        // this.options.layoutWidthBreakPoints.max = this.options.layoutWidthBreakPoints.max.sort();

        // Dynamic Elements
        $('.bb-gauge-chart').each(function(i, ele){
            _self.gaugeCharts.push($(this));
        });
        // this.gaugeCharts = $('.bb-gauge-chart');

        this.bindListeners();
    },
    openPanel: function() {
        if (this.panelState == 'opened') return;
        var _self = this;
        this.triggererButton.hide();
        this.element.animate({
            right: 10
        }, 550, function(){
           _self.panelState = 'opened'; 
        });
    },
    closePanel: function() {
        if (this.panelState == 'closed') return;
        
        var _self = this;
        if (this.element.css('left') != 'auto') {
            this.element.hide('fade', 150, function(){
                $(this).show().css({
                    top: _self.position.top,
                    right: _self.position.left,
                    left: 'auto'
                });
                _self.triggererButton.show('fade', 150);
                _self.panelState = 'closed';
            });
        } else {
            this.element.animate({
                right: this.position.left,
                top: this.position.top
            }, 550, function(){
                _self.triggererButton.show('fade', 150);
                _self.panelState = 'closed';
            });
        }
        
        var closeTabCount = gummbase.cookie.read('__gumm_user_preview_close_tab_count');
        if (closeTabCount === null) closeTabCount = 0;
        
        if (closeTabCount < 2)
        gummbase.cookie.write('__gumm_user_preview_close_tab_count', ++closeTabCount, 1);
    },
    openTab: function(tabHandle) {
        if (tabHandle.is(this.getTabHandle()) || this.animating) return;
        
        this.animating = true;
        
        var index = this.navItems.index(tabHandle);
        
        var tabContent = tabHandle.next(this.options.contentItems);
        var innerTabContent = tabContent.children(this.options.innerContent);
        var tabContentHeight = innerTabContent.outerHeight() + parseInt(innerTabContent.css('marginTop')) + parseInt(innerTabContent.css('marginBottom'));
        
        tabHandle.addClass(this.options.activeNavClass);
        var _self = this;
        this.getTabContent().animate({
            height: 0
        }, 250, 'easeInOutQuart');
        tabContent.animate({
            height: tabContentHeight
        }, 250, 'easeInOutQuart', function(){
            _self.onOpenTabAnimationComplete(index);
        });
    },
    getTabHandle: function(index) {
        if (index === undefined) index = this.current;
        return this.navItems.eq(index);
    },
    getTabContent: function(index) {
        if (index === undefined) index = this.current;
        return this.contentItems.eq(index);
    },
    onOpenTabAnimationComplete: function(forItem) {
        this.getTabHandle().removeClass(this.options.activeNavClass);
        this.getTabHandle(forItem).addClass(this.options.activeNavClass);
        this.current = forItem;
        this.animating = false;
    },
    selectSkin: function(id, changeColors) {
        if (id == this.activeSkin) return;
        
        this.getSkinSelector().removeClass(this.options.activeSkinSelectorClass);
        this.getSkinSelector(id).addClass(this.options.activeSkinSelectorClass);
        
        this.activeSkin = id;
        this.activeColors = this.skinsData[id];
        
        this.writeSkinSelectionForUser(id);
        
        if (changeColors !== false)
            this.changeColorsForSkin();
    },
    changeColorsForSkin: function(id) {
        if (id === undefined) id = this.activeSkin;
        var _colors = this.skinsData[id];
        
        var _self = this;
        $.each(_colors, function(styleName, colorValue){
            _self.changeColorsForStyleName(styleName, colorValue);
            var hexColorValue = _self.RGBToHex('rgb(' + colorValue + ')');
            _self.writeColorSelectionForUser(styleName, hexColorValue, colorValue, false);
                // writeColorSelectionForUser: function(styleName, hexString, rgbString) {
        });
    },
    changeColorsForStyleName: function(styleName, colorValue, reset) {
        var _self = this;
        if (this.styleStruct[styleName] === undefined) return false;
        if (!this.styleStruct[styleName]) return false;
        if (!colorValue) return false;
        var hexColorValue = _self.RGBToHex('rgb(' + colorValue + ')');
        
        if (styleName === 'color_option_1') {
            $.each(this.gaugeCharts, function(i, ele){
                var gc = $(ele).data('gummGaugeChart');
                if (gc !== undefined) {
                    gc.color = '#' + hexColorValue;
                    gc.draw(gc.drawnDegrees);
                }
            });
        }

        this.clearStyles(styleName);
        
        this.getColorSelector(styleName).css({
            backgroundColor: 'rgb(' + colorValue + ')'
        });
        
        var _stylePseudoString = '';
        var _styleStatesString = '';
        $.each(this.styleStruct[styleName], function(declaration, props){
            var cssProps = {};
            var cssPropsString = '';
            
            if ($.browser.mozilla !== true && declaration === '::-moz-selection') return;
            
            $.each(props, function(propName, propData){
                var _cssProp = 'rgb(' + colorValue + ')';
                if (propData.alpha !== false) {
                    _cssProp = 'rgba(' + colorValue + ', ' + propData.alpha + ')';
                }
                if (propData.declaration !== false) {
                    _cssProp = propData.declaration.replace('%s', _cssProp);
                }
                if (propData.important !== false) {
                    _cssProp += ' !important';
                }
                cssProps[propName] = _cssProp;
                cssPropsString += propName + ':' + _cssProp + ';';
            });
            
            if (typeof _self.styleSheetElements[styleName].addRule === 'function') {
                _self.styleSheetElements[styleName].addRule(declaration, cssPropsString);
            } else if (typeof _self.styleSheetElements[styleName].insertRule === 'function'){
                try {
                    _self.styleSheetElements[styleName].insertRule(declaration + '{' +  cssPropsString + '}', _self.styleSheetElements[styleName].cssRules.length);
                } catch(err){}

            }

        });
    },
    clearStyles: function(styleName) {
        var propSelector = 'rules';
        var deleteFunction = 'removeRule';
        if (this.styleSheetElements[styleName].rules === undefined && this.styleSheetElements[styleName].cssRules !== undefined) propSelector = 'cssRules';
        while(this.styleSheetElements[styleName][propSelector].length > 0) {
            if (typeof this.styleSheetElements[styleName].removeRule === 'function') {
                this.styleSheetElements[styleName].removeRule(0);
            } else if (typeof this.styleSheetElements[styleName].deleteRule === 'function'){
                this.styleSheetElements[styleName].deleteRule(0);
            }
        }
    },
    getSkinSelector: function(id) {
        if (id === undefined) id = this.activeSkin;
        
        return this.skinSelectors[id];
    },
    getColorSelector: function(styleName) {
        return this.colorSelectors[styleName];
    },
    getSkinStyleNameSelector: function(skinId, styleName) {
        var skinSelector = this.getSkinSelector(skinId);
        var result = null;
        skinSelector.children().each(function(i, ele){
            if ($(ele).data('style-name') == styleName) {
                result = $(ele);
                return false;
            }
        });
        
        return result;
    },
    changeLayoutSchema: function(schema) {
        if (this.layoutSchema == schema) return false;
        if (schema == 'l-c' || schema == 'c-r') {
            if ($('#main-content').hasClass('span12')) {
                $('#main-content').removeClass('span12').addClass('span8');
            }
        } else {
            if ($('#main-content').hasClass('span8')) {
                $('#main-content').removeClass('span8').addClass('span12');
            }
        }
        
        var sidebarBlock;
        switch (schema) {
         case 'l-c':
            sidebarBlock = this.getSidebarBlock('left');
            $('#main-content').before(sidebarBlock);
            sidebarBlock.after('<div class="span1" />');
            
            $('#main-content').next('.span1').remove();
            this.layoutSidebarsContainer.append($('#main-content').next('.right-sidebar'));
            
            break;
         case 'c-r':
            sidebarBlock = this.getSidebarBlock('right');
            $('#main-content').after(sidebarBlock);
            sidebarBlock.before('<div class="span1" />');
            
            $('#main-content').prev('.span1').remove();
            this.layoutSidebarsContainer.append($('#main-content').prev('.left-sidebar'));
            break;
         case 'none':
            $('#main-content').prev('.span1').remove();
            $('#main-content').next('.span1').remove();
            this.layoutSidebarsContainer.append($('#main-content').next('.right-sidebar'));
            this.layoutSidebarsContainer.append($('#main-content').prev('.left-sidebar'));
            break;
        }
        
        $.event.trigger('gummLayoutChanged');
        $(window).trigger('resize');
        $(window).trigger('resize');

        
        this.layoutSchema = schema;
        this.writeLayoutSelectionForUser(schema);
    },
    getSidebarBlock: function(orientation) {
        var sidebarBlock;
        switch (orientation) {
         case 'left':
            sidebarBlock = this.layoutSidebarsContainer.children('.left-sidebar');
            break;
         case 'right':
            sidebarBlock = this.layoutSidebarsContainer.children('.right-sidebar');
            break;
        }
        
        return sidebarBlock;
    },
    applyPageContentBreakPointClasses: function(val) {
        var _min = this._getMinBreakPoint(val, this.options.layoutWidthBreakPoints.min);
        var _max = this._getMaxBreakPoint(val, this.options.layoutWidthBreakPoints.max);
        
        var _bsMin = this._getMinBreakPoint(val, this.options.layoutWidthBootStrapBreakPoints.min);
        var _bsMax = this._getMaxBreakPoint(val, this.options.layoutWidthBootStrapBreakPoints.max);
        // console.log(_bsMax);
        
        var classes = $('body').attr('class');
        
        var bsCurrMinClass = /bs-min-width\-(\d+)/g.exec(classes);
        if (bsCurrMinClass !== null) $('body').removeClass(bsCurrMinClass[0]);
        var bsCurrMaxClass = /bs-max-width\-(\d+)/g.exec(classes);
        if (bsCurrMaxClass !== null) $('body').removeClass(bsCurrMaxClass[0]);
        
        var currMinClass = /min-width\-(\d+)/g.exec(classes);
        if (currMinClass !== null && currMinClass.length > 0) $('body').removeClass(currMinClass[0]);
        var currMaxClass = /max-width\-(\d+)/g.exec(classes);
        if (currMaxClass !== null && currMaxClass.length > 0) $('body').removeClass(currMaxClass[0]);

        $('body').addClass('min-width-' + _min);
        $('body').addClass('max-width-' + _max);
        
        $('body').addClass('bs-min-width-' + _bsMin);
        $('body').addClass('bs-max-width-' + _bsMax);
        // console.log(this.pageContent);
        // console.log(this.options.layoutWidthBreakPoints);
    },
    _getMaxBreakPoint: function(val, arr) {
        var _max, _prev;
        $.each(arr, function(i, bp){
            if (_prev === undefined) _prev = bp;
            if (val >= bp) {
                _max = _prev;
                return false;
            }
            _prev = bp;
        });
        return _max;
    },
    _getMinBreakPoint: function(val, arr){
        var _min;
        $.each(arr, function(i, bp){
            if (val >= bp) {
                _min = bp;
                return false;
            }
        });
        return _min;
    },
    
    writeSkinSelectionForUser: function(id) {
        gummbase.cookie.write('__gumm_user_preview_skin', id, 1);
    },
    writeColorSelectionForUser: function(styleName, hexString, rgbString, updateSkin) {
        var snSelector = this.getSkinStyleNameSelector(this.options.customUserSkinId, styleName);
        snSelector.css({
            backgroundColor: '#' + hexString
        });
        this.skinsData[this.options.customUserSkinId][styleName] = rgbString;
        if (updateSkin !== false)
            this.selectSkin(this.options.customUserSkinId, false);
        gummbase.cookie.write('__gumm_user_preview_color_selection[' + styleName + ']', hexString, 1);
    },
    writeLayoutSelectionForUser: function(schema) {
        gummbase.cookie.write('__gumm_user_preview_layout_schema', schema, 1);
    },
    writeLayoutWidthForUser: function(width) {
        gummbase.cookie.write('__gumm_user_preview_layout_width', width, 1);
    },
	RGBToHex: function (rgb) {
	    if (typeof(rgb) === 'string') {
            rgb = this.RGBFromString(rgb);
	    }
	    
		var hex = [
			rgb.r.toString(16),
			rgb.g.toString(16),
			rgb.b.toString(16)
		];
		
		$.each(hex, function (nr, val) {
			if (val.length == 1) {
				hex[nr] = '0' + val;
			}
		});
		return hex.join('');
	},
    RGBFromString: function (rgbString) {
        var rgb = {
            r: 0,
            g: 0,
            b: 0
        }
        var parts = rgbString.match(/^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/);
        if (parts.length > 0) {
            rgb.r = parts[1];
            rgb.g = parts[2];
            rgb.b = parts[3];
        }
        
        return this.fixRGB(rgb);
    },
	fixRGB: function (rgb) {
		return {
			r: Math.min(255, Math.max(0, rgb.r)),
			g: Math.min(255, Math.max(0, rgb.g)),
			b: Math.min(255, Math.max(0, rgb.b))
		};
	},
	fixHex: function (hex) {
		var len = 6 - hex.length;
		if (len > 0) {
			var o = [];
			for (var i=0; i<len; i++) {
				o.push('0');
			}
			o.push(hex);
			hex = o.join('');
		}
		return hex;
	},
	initLayoutSlider: function(element, options) {
	    var _self = this;
	    var max = $(window).width(),
	        val = $(element).data('gumm-slider-value');
	        
	    if (val === 'full') val = max;
	    
        $(element).slider({
            min: 940,
            max: max,
            step: 10,
            value: val,
            create: function(event, ui) {
                this.gummUpdateLabelValue = function(val){
                    var theLabel = $(this).prev('.gumm-slider-label');
                    var min = $(this).slider('option', 'min');
                    var max = $(this).slider('option', 'max');
                    var left = (val-min)/(max-min)*100;
                    
                    theLabel.css({
                        left: left + '%'
                    });
                    
                    var labelText = val + 'px';
                    if (val == max) labelText = 'Full';
                    theLabel.children('span:first').text(labelText);
                }
                this.updateLayoutStyleSelect = function(val) {
                    if ($(this).is(_self.layoutWidthSlider)) {
                        if (val == $(this).slider('option', 'max')) {
                            _self.layoutStyleSelect.val('full');
                        } else {
                            _self.layoutStyleSelect.val('boxed');
                        }
                    }
                }
                
                this.gummUpdateLabelValue($(this).slider('option', 'value'));
                this.gummResizeTarget = $($(this).data('gumm-resize-target'));
            },
            slide: function(event, ui) {
                var resizeValue = ui.value;
                if ($(this).slider('option', 'max') == resizeValue) resizeValue = '100%';
                this.gummUpdateLabelValue(ui.value);
                this.updateLayoutStyleSelect(ui.value);
                this.gummResizeTarget.css({
                    maxWidth: resizeValue
                });
                $(window).trigger('resize');
            },
            change: function(event, ui) {
                var resizeValue = ui.value;
                if ($(this).slider('option', 'max') == resizeValue) resizeValue = '100%';
                this.gummUpdateLabelValue(ui.value);
                this.gummResizeTarget.css({
                    maxWidth: resizeValue
                });
                $(window).trigger('resize');
            }
        });
	},
    bindListeners: function() {
        var _self = this;
        this.triggererButton.on('click', function(e){
            e.preventDefault();
            if (_self.panelState == 'closed') {
                _self.openPanel();
            } else {
                _self.closePanel();
            }
        });
        this.closerButton.on('click', function(e){
            e.preventDefault();
            _self.closePanel();
        });
        this.navItems.children('a').on('click', function(e){e.preventDefault()});
        this.navItems.on('click', function(e){
            e.preventDefault();
            _self.openTab($(this));
        });
        
        $.each(this.skinSelectors, function(skinId, ele){
            ele.on('click', function(e){
                e.preventDefault();
                _self.selectSkin($(this).data('skin-id'));                
            });
        });
        
        $.each(this.colorSelectors, function(styleName, ele){
            $(ele).ColorPicker({
                onBeforeShow: function () {
                    $(this).ColorPickerSetColor($(this).css('backgroundColor'));
                },
                onShow: function (colpkr) {
                    var $this = $(this);
                    if ($(colpkr).is(':visible')) {
                        $this.ColorPickerHide();
                        return false;
                    } else if ($(colpkr).data('gummPositionSet') === undefined) {
                        $(colpkr).css({
                            position: 'fixed',
                            left: $this.offset().left - 350,
                            top: $this.offset().top - $(document).scrollTop() - 127
                        });
                    }
                },
                onHide: function (colpkr) {
                },
                onChange: function (hsb, hex, rgb) {
                    var rgbString = rgb.r + ', ' + rgb.g + ', ' + rgb.b;
                    _self.changeColorsForStyleName(styleName, rgbString, true);
                    _self.writeColorSelectionForUser(styleName, hex, rgbString);
                },
                onSubmit: function(hsb, hex, rgb, el) {
                    $(el).ColorPickerHide();
                    var rgbString = rgb.r + ', ' + rgb.g + ', ' + rgb.b;
                    _self.changeColorsForStyleName(styleName, rgbString, true);
                    _self.writeColorSelectionForUser(styleName, hex, rgbString);
                }
            });
        });
        
        this.layoutSelectors.on('click', function(e){
            e.preventDefault();
            $(this).siblings().removeClass('current');
            $(this).addClass('current');
            _self.changeLayoutSchema($(this).data('layout-schema'));
        });
        
        this.initLayoutSlider(this.layoutWidthSlider);
        this.initLayoutSlider(this.contentWidthSlider);
        
        this.fontSelectBrowser.on('change', function(e){
            $('body').css({
                'font-family': $(this).val()
            });
        });
        this.fontSelectGoogle.on('change', function(e){
            var fontFamily = $(this).val();
            loadGoogleWebFonts([fontFamily]);
            $(document).on('gummGoogleFontsLoaded', function(e){
                $('body').css({
                    'font-family': fontFamily
                });
            });
        });
        
        this.layoutStyleSelect.on('change', function(e){
            if ($(this).val() === 'boxed') {
                _self.layoutWidthSlider.slider('value', 1020);
                
            } else {
                _self.layoutWidthSlider.slider('value', _self.layoutWidthSlider.slider('option', 'max'));
            }
        });
        
        
        this.backgroundChooser.on('change', function(e){
            $('body').css({
                backgroundImage: "url('" + $(this).val() + "')"
            });
            if (_self.layoutStyleSelect.val() !== 'boxed') {
                alert("Please select, boxed layout.");
            }
        });
        this.navMainChooser.on('change', function(e){
            _self.primeNavElement.removeClass(_self.navMainClassesAvailable.join(' '));
            _self.primeNavElement.addClass($(this).val());
        });
        this.navDropChooser.on('change', function(e){
            _self.primeNavElement.removeClass(_self.navDropClassesAvailable.join(' '));
            _self.primeNavElement.addClass($(this).val());
        });
        
        // loadGoogleWebFonts(GummGoogleFontsList[0]);
    }
}
$.fn.gummFrontEndDemoPanel = function gummFrontEndDemoPanelFn(options, callback) {
    this.each(function () {
        var instance = $.data(this, 'gummFrontEndDemoPanel');
        if (instance) {
            // update options of current instance
            // instance.update(options);
        } else {
            $.data(this, 'gummFrontEndDemoPanel', new $.gummFrontEndDemoPanel(options, callback, this));
        }
        
    });
    return this;
}
})( jQuery );
</script>

