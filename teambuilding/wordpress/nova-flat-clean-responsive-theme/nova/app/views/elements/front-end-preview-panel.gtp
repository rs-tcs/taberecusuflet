<?php
$clientResolution = $this->Media->getClientResolution();
if ($clientResolution <= 768) return '';
// Colors
$customUserSkinId = Configure::read('Skin.customUserSkinId');

$stylesStructure = $this->Html->getStylesStructureForLayout();
$skinStylesStructure = array();
$stylesData = array_merge(array(
    'default' => array(),
), (array) get_option(GUMM_THEME_PREFIX . '_styles'));


if (!$stylesData) return '';

$activeSkin = GummRegistry::get('Model', 'Skin')->getActiveSkin();
$skins = GummRegistry::get('Model', 'Skin')->find('all');

if (!isset($skins[$activeSkin])) $activeSkin = 'default';
if (!isset($skins[$customUserSkinId])) $customUserSkinId = null;

$skinsData = array();
$defaultColorOptions = array(
    'color_option_1' => null,
    'color_option_2' => null,
    'color_option_3' => null,
    // 'color_option_4' => null,
);
if (!$stylesData['default']) {
    $stylesData['default'] = array(
        'color_options' => $skins['default']['color_options'],
    );
}
foreach ($stylesData as $skinId => &$skinStyleData) {
    if (!isset($skins[$skinId])) continue;

    foreach ($skinStyleData['color_options'] as $styleName => &$styleValue) {
        $styleValue = implode(', ', $this->Number->hex2rgb($styleValue));
    }
    $skinsData[$skinId] = array_merge($defaultColorOptions, $skinStyleData['color_options']);
}

$mergeFrom = $activeSkin != $customUserSkinId ? $activeSkin : 'default';
foreach ($skinsData[$mergeFrom] as $styleName => $styleVal) {
    $skinsData[$customUserSkinId][$styleName] = $styleVal;
    if ($customVal = GummHash::get($_COOKIE, '__gumm_user_preview_color_selection.' . $styleName)) {
        $skinsData[$customUserSkinId][$styleName] = implode(', ', $this->Number->hex2rgb($customVal));
    }
}

// Layout
$LayoutModel = GummRegistry::get('Model', 'Layout');
$LayoutHelper = GummRegistry::get('Helper', 'Layout');

$layoutSchema = $LayoutModel->findSchemaStringForLayout();

$LayoutModel->setSchemaStringForLayout('l-c-r');

$layoutWidth = $LayoutHelper->getWrapWidth(false);
$contentWidth = $LayoutHelper->getContentWidth(false);

if ($layoutWidth != 'full' && $layoutWidth == $clientResolution) {
    $layoutWidth = 'full';
}

// Backgrounds
$backgroundImages = array(
    'http://antonibotev.com/themes/roki/wp-content/uploads/2013/01/bg1.jpg' => 'background image 1',
    'http://antonibotev.com/themes/roki/wp-content/uploads/2013/01/bg2.jpg' => 'background image 2',
    'http://antonibotev.com/themes/roki/wp-content/uploads/2013/01/bg3.jpg' => 'background image 3',
    'http://antonibotev.com/themes/roki/wp-content/uploads/2013/01/bg4.jpg' => 'background image 4',
);

// Fonts
$FontComponent = GummRegistry::get('Component', 'Fonts');
$googleFontsList = $FontComponent->getGoogleFontsList('list');
$browserFontsList = $FontComponent->getBrowserFontsList('list');

wp_enqueue_script('jquery-ui-slider');
wp_enqueue_script('jquery-ui-draggable');

$tabCloseCount = (isset($_COOKIE['__gumm_user_preview_close_tab_count'])) ? (int) $_COOKIE['__gumm_user_preview_close_tab_count'] : 0;

$panelState = 1 <= $tabCloseCount ? 'closed' : 'opened';

// Navigation
$mainNavStyles = array(
    'nav-standard' => 'standard',
    'nav-block' => 'block',
    'nav-button' => 'button',
);
$dropDownNavStyles = array(
    'drop-bubble-light' => 'bubble light',
    'drop-bubble-dark' => 'bubble dark',
    'drop-block-light' => 'block light',
    'drop-block-dark' => 'block dark',
);
?>

<div id="front-end-demo-panel" class="frond-end-demo-panel state-<?php echo $panelState; ?>" style="display: block;">
    <a id="front-end-preview-panel-triggerer" href="#"><span class="icon-cogs"></span></a>
    <a id="front-end-preview-panel-closer" href="#"><span>×</span></a>
	<span class="panel-heading">Demo Options</span>
	<div class="inner-panel-container">
    
        <strong class="demo-accordion-header colors current" data-tab-handle-for="colors">
        	<a href="#" class="demo-accordion-header-link">Colors</a><span></span>
        </strong>
        <div class="front-end-demo-panel-content" data-tab-content="colors">
            <div class="front-end-demo-panel-inner-content">
