                        <option value="boxed"<?php if ($layoutWidth != 'full') echo ' selected="selected"'; ?>><?php _e('Boxed', 'gummfw'); ?></option>
                    </select>
                    <div class="gumm-slider-label"><span><?php echo $LayoutHelper->getWrapWidth(); ?></span></div>
