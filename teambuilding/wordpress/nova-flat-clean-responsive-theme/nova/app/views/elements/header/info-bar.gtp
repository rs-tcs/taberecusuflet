<?php
$infoText = $this->Wp->getOption('header_info');
$shouldRender = (bool) $infoText;
$shouldRender = apply_filters('gumm_header_info_bar_should_render', $shouldRender);
?>

<?php if ($shouldRender): ?>
    <?php

    
    $post = GummRegistry::get('Model', 'Post')->getQueriedObject();
    
    $displayInfoBar = $this->Wp->getOption('header_info_display');
    $infoBarStyle   = $this->Wp->getOption('header_info_bar_style');
    if (is_a($post, 'WP_POST')) {
        if (isset($post->PostMeta['header_settings']) && $post->PostMeta['header_settings'] === 'custom') {
            $displayInfoBar = $post->PostMeta['header_info_display'];
            $infoBarStyle   = $post->PostMeta['header_info_bar_style'];
        }
    }
    
    if ($displayInfoBar === true || $displayInfoBar === 'true'):
        
    $divAtts = array(
        'class' => array(
            'bluebox-info-bar', 'bluebox-bottom-shadow', $infoBarStyle
        ),
    );
    $divAtts = apply_filters('gumm_header_info_bar_attributes', $divAtts);
    ?>
	<div<?php echo $this->Html->_constructTagAttributes($divAtts); ?>>
    	<div class="bluebox-container">
    	    <div class="info-bar-text">
                <?php echo $infoText; ?>
            </div>
            <?php do_action('gumm_header_info_bar_after_text'); ?>
        </div>
    </div>
    <?php endif; ?>
<?php endif; ?>